# Supabase — copier en .env.local et remplir avec les valeurs de votre projet.
# (Le jeu en solo local fonctionne SANS ces variables ; elles n'activent que
#  le backend multijoueur : API serveur, auth, temps reel.)

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# SERVEUR UNIQUEMENT — ne jamais exposer cote client. Contourne RLS et execute
# la simulation faisant autorite (Tome 2 section 15-16).
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY
